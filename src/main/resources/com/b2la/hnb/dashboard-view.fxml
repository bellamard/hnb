                    <VBox fx:id="depenseLayout" spacing="16" styleClass="section" visible="false">
                        <children>

                            <!-- Titre principal -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <children>
                                    <FontIcon iconLiteral="fa-money" iconSize="20" />
                                    <Label styleClass="section-title" text="Gestion des Dépenses" />
                                </children>
                            </HBox>

                            <Separator />

                            <!-- Barre de recherche moderne -->
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <children>
                                    <FontIcon iconLiteral="fa-search" iconSize="16" />
                                    <TextField fx:id="searchSpent" onKeyPressed="#getSearchSpents" prefWidth="250" promptText="Rechercher une dépense..." />
                                </children>
                            </HBox>

                            <!-- Tableau principal -->
                            <HBox alignment="TOP_LEFT" spacing="14">
                                <children>
                                    <TableView fx:id="spentTable" prefHeight="400" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colSpentDate" prefWidth="100" text="📅 Date" />
                                            <TableColumn fx:id="colSpentTitle" prefWidth="180" text="Titre" />
                                            <TableColumn fx:id="colSpentPrice" prefWidth="120" text="💲 Montant" />
                                            <TableColumn fx:id="colSpentMotif" prefWidth="200" text="Motif" />
                                            <TableColumn fx:id="colSpentFor" prefWidth="150" text="Pour" />
                                            <TableColumn fx:id="colSpentAuthor" prefWidth="150" text="Auteur" />
                                            <TableColumn fx:id="colSpentAction" prefWidth="100" text="⚙️ Action" />
                                        </columns>
                                    </TableView>

                                    <!-- Zone d'aperçu -->
                                    <VBox alignment="TOP_LEFT" spacing="8">
                                        <children>
                                            <Label styleClass="apercu-title" text="📊 Aperçu" />
                                            <Label fx:id="apercusSpentText" text="Sélectionnez une dépense..." wrapText="true" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <!-- Formulaire moderne -->
                            <TitledPane animated="true" expanded="false" text="➕ Ajouter / Modifier une Dépense">
                                <VBox spacing="16" styleClass="form-card">
                                    <padding>
                                        <Insets bottom="16" left="16" right="16" top="16" />
                                    </padding>
                                    <children>

                                        <GridPane hgap="12" vgap="12">
                                            <Label styleClass="form-label" text="Titre" />
                                            <TextField fx:id="titleSpent" GridPane.columnIndex="1" />

                                            <Label styleClass="form-label" text="Montant" GridPane.rowIndex="1" />
                                            <TextField fx:id="priceSpent" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                            <Label styleClass="form-label" text="Pour" GridPane.rowIndex="2" />
                                            <TextField fx:id="forSpent" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                            <Label styleClass="form-label" text="Motif" GridPane.rowIndex="3" />
                                            <TextArea fx:id="motifSpent" prefRowCount="4" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                            <Label fx:id="msgAlertSpent" GridPane.rowIndex="4" />
                                            <columnConstraints>
                                                <ColumnConstraints />
                                                <ColumnConstraints />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                            </rowConstraints>
                                        </GridPane>

                                        <!-- Boutons d'action -->
                                        <HBox alignment="CENTER_RIGHT" spacing="12">
                                            <children>
                                                <Button fx:id="btnCreateSpent" onAction="#addSpent" styleClass="btn-primary" text="Créer">
                                                    <graphic>
                                                        <FontIcon iconLiteral="fa-floppy-o" iconSize="16" />
                                                    </graphic>
                                                </Button>
                                                <Button fx:id="btnModifierSpent" styleClass="btn-warning" text="Modifier">
                                                    <graphic>
                                                        <FontIcon iconLiteral="fa-pencil" iconSize="16" />
                                                    </graphic>
                                                </Button>
                                                <Button onAction="#resetDepense" styleClass="btn-danger" text="Annuler">
                                                    <graphic>
                                                        <FontIcon iconLiteral="fa-close" iconSize="16" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </TitledPane>

                        </children>
                    </VBox>

                    <VBox fx:id="clotureLayout" spacing="10" styleClass="section">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <children>
                                    <FontIcon iconLiteral="fa-money" iconSize="20" />
                                    <Label styleClass="section-title" text="Gestion des Bilans" />
                                </children>
                            </HBox>

                            <Separator />
                     <HBox alignment="CENTER">
                        <children>
                           <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label styleClass="section-title" text="BILAN:" />
                                 <Label text="DATE:" />
                                 <Label text="REF:" />
                              </children>
                              <padding>
                                 <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                              </padding>
