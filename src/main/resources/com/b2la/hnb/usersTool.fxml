<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="5.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.b2la.hnb.controllers.utilisateurController">
   <children>
      <Label text="UTILISATEURS">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <HBox spacing="14.0">
         <children>
            <TableView fx:id="tableView" >
              <columns>
                <TableColumn fx:id="username"  text="Username" />
                <TableColumn fx:id="phone"  text="Phone" />
                <TableColumn fx:id="fonction"  text="Fonction" />
                <TableColumn fx:id="email"  text="Email" />
                <TableColumn fx:id="action" text="Action" />

              </columns>
            </TableView>
            <VBox spacing="8.0">
               <children>
                  <TextField fx:id="fieldUsername" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="user name" />
                  <TextField fx:id="fieldPhone" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="telephone" />
                  <TextField fx:id="fieldEmail" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="e-mail" />
                  <ComboBox fx:id="comboFonction" prefWidth="150.0" />
                  <TextField fx:id="password" accessibleRole="PASSWORD_FIELD" layoutX="10.0" layoutY="77.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="********" />
                  <TextField fx:id="confirme" accessibleRole="PASSWORD_FIELD" layoutX="10.0" layoutY="144.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" promptText="********" />
                  <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addUtilisateur" prefHeight="40.0" prefWidth="120.0" text="AJOUTER" />
                  <Button fx:id="btnModifierUser" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#modifier" prefHeight="40.0" prefWidth="120.0" text="MODIFIER" visible="false" />
               </children>
            </VBox>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </HBox>
   </children>
   <padding>
      <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
   </padding>
</VBox>
